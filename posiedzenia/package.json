{
  "name": "posiedzenia-oipip-slupsk",
  "version": "0.1.0",
  "private": true,
  "description": "Aplikacja do prowadzenia posiedzeń Prezydium ORPiP w Słupsku (etap 1).",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.server.config.ts",
    "start": "node dist/server.mjs",
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "dom-serializer": "3.1.1",
    "domutils": "4.0.2",
    "htmlparser2": "12.0.0",
    "mammoth": "1.13.0",
    "marked": "18.1.1",
    "preact": "10.29.8",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
